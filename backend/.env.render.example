# Modelo sem credenciais. Preencha somente no painel do Render.
NODE_ENV=production
NODE_VERSION=24.11.1
DATABASE_URL=<internal-database-url-do-render>
FRONTEND_ORIGIN=https://<frontend-autorizado>
PUBLIC_API_URL=https://<api>.onrender.com/api/v1
ROUTER_PUBLIC_API_URL=https://<api>.onrender.com/api/v1
SOURAD_WEB_URL=https://<frontend-climbesoftrad>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=1
PUBLIC_REGISTRATION_ENABLED=false
SWAGGER_ENABLED=false
OAUTH_CLIENT_ID=crm-web
JWT_ISSUER=<mesmo-issuer-configurado>
JWT_AUDIENCE=<mesma-audience-configurada>
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt_public.pem
ADMIN_EMAIL=<email-do-administrador>
ADMIN_PASSWORD=<senha-forte-do-administrador>
CLOUDFLARE_R2_ENDPOINT=<endpoint-do-bucket>
CLOUDFLARE_R2_BUCKET=<bucket>
CLOUDFLARE_R2_ACCESS_KEY=<access-key>
CLOUDFLARE_R2_SECRET_KEY=<secret-key>
CLOUDFLARE_R2_REGION=auto
CNPJA=<chave-cnpja>
DIRECTD_CFM_TOKEN=<chave-directd>
GEMINI_RESEARCH_ENABLED=false
ROUTER_CREDENTIAL_SECRET=<segredo-estavel-ou-manter-derivacao-atual>
ROUTER_TLS_KEY_PATH=
ROUTER_TLS_CERT_PATH=
# Serviços DICOM precisam de endereços acessíveis em produção.
ORTHANC_INTERNAL_URL=
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
OHIF_VIEWER_URL=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Convites médicos: RESEND usa a API; SMTP mantém a opção de servidor próprio.
EMAIL_PROVIDER=SMTP
API_RESEND_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
