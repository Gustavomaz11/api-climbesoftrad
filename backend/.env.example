## Cloudflare R2 (mantenha as credenciais somente no backend)
CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=nome-do-bucket
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ACCESS_KEY=access-key-id
CLOUDFLARE_R2_SECRET_KEY=secret-access-key

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
SOURAD_CENTRAL_COMPANY_ID=00000000-0000-4000-8000-000000000001
DIRECTD_CFM_URL=https://apiv3.directd.com.br/api/ConselhoFederalMedicina
DIRECTD_CFM_TOKEN=
OAUTH_CLIENT_ID=crm-web

JWT_ISSUER=crm-api
JWT_AUDIENCE=crm-web
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

ACCESS_TOKEN_TTL_SECONDS=600
AUTHORIZATION_CODE_TTL_SECONDS=60
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_SECONDS=900

# Rate limiting global: rajada, janela padrÃ£o e uso sustentado.
RATE_LIMIT_BURST_WINDOW_SECONDS=10
RATE_LIMIT_BURST_REQUESTS=30
RATE_LIMIT_STANDARD_WINDOW_SECONDS=60
RATE_LIMIT_STANDARD_REQUESTS=120
RATE_LIMIT_SUSTAINED_WINDOW_SECONDS=900
RATE_LIMIT_SUSTAINED_REQUESTS=1000

# Quantidade exata de proxies reversos confiÃ¡veis atÃ© a API. Use 0 quando exposta diretamente.
TRUST_PROXY_HOPS=0

PUBLIC_REGISTRATION_ENABLED=true
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD='<defina-uma-senha-forte>'
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
SWAGGER_ENABLED=true

# ProduÃ§Ã£o exige NODE_ENV=production, FRONTEND_ORIGIN com HTTPS e COOKIE_SECURE=true.

# Ownership confirmed before migrating existing records.
LEGACY_COMPANY_NAME=Sourad

# Protótipo de pesquisa sem uso clínico. A chave permanece somente na API.
GEMINI_API_KEY=
GEMINI_RESEARCH_ENABLED=false
GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
GEMINI_RESEARCH_REQUEST_TIMEOUT_MS=120000
GEMINI_RESEARCH_IMAGES_PER_REQUEST=1
GEMINI_RESEARCH_MAX_FRAMES=200
SOURAD_WEB_URL=http://localhost:5173

# Cadastro da empresa: chave somente no backend.
CNPJA=
# Router: destino HTTPS gravado nos próximos instaladores.
ROUTER_PUBLIC_API_URL=https://localhost:3443/api/v1
ROUTER_TLS_PORT=3443
ROUTER_TLS_KEY_PATH=
ROUTER_TLS_CERT_PATH=
ROUTER_INSTALLER_ROOT=../instalavel
# Opcional: segredo estável (mínimo 32 caracteres). Vazio usa a chave privada JWT.
ROUTER_CREDENTIAL_SECRET=
